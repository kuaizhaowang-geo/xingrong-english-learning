# ============================================================
# 星荣英语 - 环境变量示例
# 复制为 .env 并修改为实际值
# ============================================================

# ---- 应用 ----
NODE_ENV=production
PORT=3000
# 应用密钥（用于会话、加密等，务必修改为随机长字符串）
APP_SECRET=your-app-secret-key-here-please-change

# ---- 数据库 PostgreSQL ----
DATABASE_URL=postgresql://app_user:your_password@localhost:5432/xingrong_english

# ---- Redis（缓存 + 会话） ----
REDIS_URL=redis://:your_password@localhost:6379

# ---- CDN（可选，静态资源加速） ----
# CDN_URL=https://cdn.yourdomain.com

# ---- 限流（可选） ----
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000
